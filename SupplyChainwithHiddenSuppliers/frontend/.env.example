# Frontend dashboard configuration (copy to .env.local to override defaults).
# Defaults target the local devnet from docker compose.

# GraphQL endpoint of the Midnight indexer.
VITE_MIDNIGHT_INDEXER_URL=http://127.0.0.1:8088/api/v4/graphql

# Deployed contract address from .midnight-state.json (or set it in the UI).
VITE_MIDNIGHT_CONTRACT_ADDRESS=

# undeployed | preview | preprod
VITE_MIDNIGHT_NETWORK=undeployed
