# ChainShield frontend — configuration (copy to .env.local to override).
#
# Defaults target the public Midnight **Preview** network.

# Which Midnight network to expect. The DApp Connector validates that the
# connected wallet matches this id. (preview | preprod | undeployed)
VITE_NETWORK=preview

# GraphQL endpoint of the Midnight indexer that serves PUBLIC contract state.
VITE_INDEXER_URL=https://indexer.preview.midnight.network

# The deployed contract address / contract ID (from .midnight-state.json).
VITE_CONTRACT_ADDRESS=

# Enable the "prove & publish" panel wired to a DApp Connector wallet.
# Requires a funded Midnight Wallet browser extension on VITE_NETWORK.
VITE_ENABLE_PROVE=false

# DATA-DEMO MODE — full no-setup clickthrough for judges/recruiters.
# When true AND VITE_CONTRACT_ADDRESS is empty, the dashboard renders a seeded
# example ledger (single-origin coffee) and "Prove & publish" is simulated
# in-browser. NO wallet, NO tNIGHT, NO proof relay required.
VITE_DEMO_MODE=true

# Optional: base URL the wallet connector uses to load the compiled ZK assets.
VITE_ZK_ASSETS_URL=managed/supply-chain